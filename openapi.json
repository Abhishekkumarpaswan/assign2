  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "ticket_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "tools_used": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Tools Used",
            "default": []
          },
          "ticket_status": {
            "type": "string",
            "title": "Ticket Status"
          },
          "refund_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Status"
          },
          "escalated": {
            "type": "boolean",
            "title": "Escalated",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "response",
          "ticket_status"
        ],
        "title": "ChatResponse"
      },
      "EscalationDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "^(approved|rejected|info_requested)$",
            "title": "Decision"
          },
          "internal_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Internal Note"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "EscalationDecision"
      },
      "EscalationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "internal_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Internal Note"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ticket_id",
          "summary",
          "priority",
