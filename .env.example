# ============================================================
# KINETIC E-COMMERCE AI SUPPORT ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust variables as required.
# ============================================================

# Project Name
PROJECT_NAME="Kinetic E-Commerce AI Support"

# Application Environment (development, production)
ENVIRONMENT="development"

# Set SECRET_KEY to a private random value when deploying beyond local development.

# Database Connection (Default: SQLite local database)
# DATABASE_URL="sqlite:///./kinetic_support.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://kinetic_user:kinetic_password@localhost:5432/kinetic_db"

# Business Rules Guardrails
MAX_AUTO_REFUND_AMOUNT=5000.0
DEFAULT_RETURN_WINDOW_DAYS=14

# AI Support Agent Mode (auto, gemini, groq, mock)
# "auto" uses a configured provider or local replies when no API key is present.
LLM_PROVIDER="auto"

# Keep provider keys in this local file; never commit them.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
